# Openrouter
OPENROUTER_KEY=sk-or-v1-**

# First custom endpoint (OpenRouter example)
LIBRECHAT_ENDPOINTS_CUSTOM_0_NAME=OpenRouter
LIBRECHAT_ENDPOINTS_CUSTOM_0_APIKEY="${OPENROUTER_KEY}"
LIBRECHAT_ENDPOINTS_CUSTOM_0_BASEURL=https://openrouter.ai/api/v1
LIBRECHAT_ENDPOINTS_CUSTOM_0_HEADERS='x-librechat-body-parentmessageid:{{LIBRECHAT_BODY_PARENTMESSAGEID}}'
LIBRECHAT_ENDPOINTS_CUSTOM_0_MODELS_DEFAULT=anthropic/claude-sonnet-4:online
LIBRECHAT_ENDPOINTS_CUSTOM_0_MODELS_FETCH=true
LIBRECHAT_ENDPOINTS_CUSTOM_0_TITLECONVO=true
LIBRECHAT_ENDPOINTS_CUSTOM_0_TITLEMODEL=deepseek/deepseek-chat-v3-0324:free
LIBRECHAT_ENDPOINTS_CUSTOM_0_DROPPARAMS=stop
LIBRECHAT_ENDPOINTS_CUSTOM_0_MODELDISPLAYLABEL="Claude Sonnet 4 Online"

# Second custom endpoint example (uncomment to use)
