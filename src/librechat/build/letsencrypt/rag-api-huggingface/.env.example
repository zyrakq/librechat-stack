# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=librechat

HOST=0.0.0.0
MONGO_URI=mongodb://librechat-mongodb:27017/LibreChat

CREDS_KEY=f34be427ebb29de8d88c107a71546019685ed8b241d8f2ed00c3df97ad2566f0
CREDS_IV=e2341419ec3dd3d19b13a1a87fafcbfb

JWT_SECRET=16f8c0ef4a5d391b26034086c628469d3f9f497f08163ab9b40137092f2909ef
JWT_REFRESH_SECRET=eaa5191f2914e30b9387fd84e254e4ba6fc51b4654968a9b0803b456a54b8418

SEARCH=false

# === LIBRECHAT CONFIGURATION ===
# Configuration version
LIBRECHAT_VERSION=1.2.1

# Cache settings
LIBRECHAT_CACHE=true

# File storage configuration
# LIBRECHAT_FILESTRATEGY=local
# LIBRECHAT_FILESTRATEGY_AVATAR=local
# LIBRECHAT_FILESTRATEGY_IMAGE=local
# LIBRECHAT_FILESTRATEGY_DOCUMENT=local

# Interface configuration
LIBRECHAT_INTERFACE_CUSTOMWELCOME='Welcome to LibreChat! Enjoy your experience.'
LIBRECHAT_INTERFACE_ENDPOINTSMENU=true
LIBRECHAT_INTERFACE_MODELSELECT=true
LIBRECHAT_INTERFACE_PARAMETERS=true
LIBRECHAT_INTERFACE_SIDEPANEL=true
LIBRECHAT_INTERFACE_PRESETS=true
LIBRECHAT_INTERFACE_PROMPTS=true
LIBRECHAT_INTERFACE_BOOKMARKS=true
LIBRECHAT_INTERFACE_MULTICONVO=true
LIBRECHAT_INTERFACE_AGENTS=true

# Privacy Policy
# LIBRECHAT_INTERFACE_PRIVACYPOLICY_EXTERNALURL=https://librechat.ai/privacy-policy
# LIBRECHAT_INTERFACE_PRIVACYPOLICY_OPENNEWTAB=true

# Terms of Service
# LIBRECHAT_INTERFACE_TERMSOFSERVICE_EXTERNALURL=https://librechat.ai/tos
# LIBRECHAT_INTERFACE_TERMSOFSERVICE_OPENNEWTAB=true
# LIBRECHAT_INTERFACE_TERMSOFSERVICE_MODALACCEPTANCE=true
# LIBRECHAT_INTERFACE_TERMSOFSERVICE_MODALTITLE=Terms of Service for LibreChat

# People Picker
LIBRECHAT_INTERFACE_PEOPLEPICKER_USERS=true
LIBRECHAT_INTERFACE_PEOPLEPICKER_GROUPS=true
LIBRECHAT_INTERFACE_PEOPLEPICKER_ROLES=true

# Marketplace
LIBRECHAT_INTERFACE_MARKETPLACE_USE=false

# Temporary chat retention period in hours
# LIBRECHAT_INTERFACE_TEMPORARYCHATRETENTION=720

# Cloudflare Turnstile
# LIBRECHAT_TURNSTILE_SITEKEY=your-site-key-here
# LIBRECHAT_TURNSTILE_OPTIONS_LANGUAGE=auto
# LIBRECHAT_TURNSTILE_OPTIONS_SIZE=normal

# Registration
# LIBRECHAT_REGISTRATION_SOCIALLOGINS="github", "google", "discord", "openid", "facebook", "apple", "saml"
# LIBRECHAT_REGISTRATION_ALLOWEDDOMAINS=gmail.com,example.com

# Balance settings
# LIBRECHAT_BALANCE_ENABLED=false
# LIBRECHAT_BALANCE_STARTBALANCE=20000
# LIBRECHAT_BALANCE_AUTOREFFILLENABLED=false
# LIBRECHAT_BALANCE_REFILLINTERVALVALUE=30
# LIBRECHAT_BALANCE_REFILLINTERVALUNIT=days
# LIBRECHAT_BALANCE_REFILLAMOUNT=10000

# Actions
# LIBRECHAT_ACTIONS_ALLOWEDDOMAINS=swapi.dev,librechat.ai,google.com

# Assistants endpoint
# LIBRECHAT_ENDPOINTS_ASSISTANTS_DISABLEBUILDER=false
# LIBRECHAT_ENDPOINTS_ASSISTANTS_POLLINTERVALMS=3000
# LIBRECHAT_ENDPOINTS_ASSISTANTS_TIMEOUTMS=180000
# LIBRECHAT_ENDPOINTS_ASSISTANTS_SUPPORTEDIDS="asst_supportedAssistantId1", "asst_supportedAssistantId2"
# LIBRECHAT_ENDPOINTS_ASSISTANTS_EXCLUDEDIDS="asst_excludedAssistantId"
# LIBRECHAT_ENDPOINTS_ASSISTANTS_PRIVATEASSISTANTS=false
# LIBRECHAT_ENDPOINTS_ASSISTANTS_RETRIEVALMODELS="gpt-4-turbo-preview"
# LIBRECHAT_ENDPOINTS_ASSISTANTS_CAPABILITIES="code_interpreter", "retrieval", "actions", "tools", "image_vision"

# Agents endpoint
LIBRECHAT_ENDPOINTS_AGENTS_CAPABILITIES='"actions", "tools"'
# LIBRECHAT_ENDPOINTS_AGENTS_RECURSIONLIMIT=50
# LIBRECHAT_ENDPOINTS_AGENTS_MAXRECURSIONLIMIT=100
# LIBRECHAT_ENDPOINTS_AGENTS_DISABLEBUILDER=false
# LIBRECHAT_ENDPOINTS_AGENTS_MAXCITATIONS=30
# LIBRECHAT_ENDPOINTS_AGENTS_MAXCITATIONSPERFILE=7
# LIBRECHAT_ENDPOINTS_AGENTS_MINRELEVANCESCORE=0.45
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=3080
VIRTUAL_HOST=librechat.example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=librechat.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
# Rag Api
LIBRECHAT_INTERFACE_FILESEARCH=true
LIBRECHAT_INTERFACE_FILECITATIONS=true

POSTGRES_DB=librechat
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2